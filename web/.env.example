# Server-side ingestion credentials. The secret key remains available to the
# collector and normalizer, but the web viewer never uses it for member reads.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Browser-safe Supabase Auth configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Optional in local development. Required when CAPTCHA is enabled in Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Viewer scope and display settings.
SIUS_RANGE_ID=default-range
SIUS_VIEWER_TIMEZONE=America/Vancouver
